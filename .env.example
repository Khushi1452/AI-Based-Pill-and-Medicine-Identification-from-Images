# ==============================================================================
# MEDISCAN AI - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Google Gemini API Key (Required for multimodal visual reasoning fallback)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Intelligent Caching TTL (seconds; default 86400 = 24 hours)
CACHE_TTL_SECONDS=86400

# Local AI Candidate Matching Thresholds
LOCAL_CONFIDENCE_THRESHOLD=0.82
AMBIGUITY_MARGIN=0.08

# Healthcare Data Privacy & Image Retention Control
# Set to 'true' to store encrypted/hashed packaging images locally; 'false' to discard after analysis
IMAGE_RETENTION_ENABLED=false

# Tesseract OCR executable path (Auto-detected on macOS Apple Silicon if using Homebrew)
TESSERACT_CMD="/opt/homebrew/bin/tesseract"
